format os2 dll
name RTL8821AU.OS2
option quiet,map=RTL8821AU.map,verbose,caseexact,eliminate,nodefaultlibs
option description '@#RTL8821AU-OS2:0.1.3#@##1## 28 Oct 2026 12:00:00     ARCAOS-DEV::en:US:2:::@@Realtek RTL8821AU USB WiFi driver for OS/2 and ArcaOS (GenMAC + NDIS)'
segment class 'CODE' iopl
import DOSOPEN DOSCALLS.70
import DOSCLOSE DOSCALLS.59
import DOSREAD DOSCALLS.137
import DOSDEVIOCTL DOSCALLS.53
file rt_hdr.obj
file rt_lib.obj
file rt_ndisx.obj
file rt_strat.obj
file rt_usb.obj
file rt_ndis.obj
file rtl_nic.obj
file rtl_dhcp.obj
file rtl_dbg.obj
file rtl_rx.obj
file rtl8821_hal.obj
file rtl8821_phy.obj
file rtl8821_tbl.obj
file rtl8821_efuse.obj
file rtl8821_tx.obj
file rtw_reg.obj
file rt_end.obj
